#!/usr/bin/expect
# GCM runs a host under this script only when it has a stored password, and a Telnet or RDP
# host only when it has a user too; the others run ssh, telnet or FreeRDP directly. The
# password comes in GCM_PASSWORD, from expect_environment in utils/connections.py, and the
# script's exit status becomes the tab's.

log_user 0
# Keys typed into the tab wait for the program, whose own terminal shows them once they
# reach it. Echoed here too, measured, an ls typed early showed twice: in front of the
# password prompt, and again in the session.
stty -echo

# The stored password, which GCM gives in the environment, and not the program's to
# inherit. GCM used to type it into the tab 2 s after the spawn, and the script started
# nothing until it came, so every connection started 2 s late, and anything typed into
# the tab meanwhile became part of the password (#314).
set pass ""
if { [info exists env(GCM_PASSWORD)] } {
    set pass $env(GCM_PASSWORD)
    unset env(GCM_PASSWORD)
}


#capturar redimension de tamaño de pantalla y pasarlo al proceso ssh hijo
# Before the spawn too, as a new tab settles its size then: measured in GCM, the trap is set
# within 60 ms of addTab, and a new tab's size changed at about 0.2 s and 0.4 s. And expect
# gives the program the size its own terminal had when expect started, or when stty last
# read it, measured. Until the spawn there is no program's terminal to set, and naming it
# then is a Tcl error, which shows in the tab. A change before the trap is set is lost
# until the WINCH sent as a session is handed over.
trap {
 set rows [stty rows]
 set cols [stty columns]
 if { [info exists spawn_out(slave,name)] } {
  stty rows $rows columns $cols < $spawn_out(slave,name)
 }
} WINCH


set connection [ lindex $argv 0 ]

set i 0
foreach {arg} $argv {
   set i [ expr $i+1 ];
   if {$arg=="-l"} {
      set user [ lindex $argv $i ]
   }
}

if { $connection == "telnet" } {
    set timeout 20
    set cmd "/usr/bin/telnet"
    set reg "assword:"
} elseif { $connection == "rdp" } {
    # FreeRDP's client is xfreerdp3 or xfreerdp, whichever is installed, so GCM names it
    # as the first of the arguments below.
    set timeout -1
    set cmd ""
    set reg "assword:"
} else {
    # Not -1, which waited for ever. Each second without a pattern matched, the block
    # below looks at what ssh is doing, as it may never ask for the password (#313).
    # expect's timeout is whole seconds, measured: 0.25 times out at once, and output that
    # matches nothing does not restart it.
    set timeout 1
    set cmd "/usr/bin/ssh"
    set reg "assword:"
}

# What ssh's own terminal, the pty it was spawned on, says it is doing: "session" once its
# session has started, which puts the terminal in raw mode, "secret" while it reads with
# echo off, and "" while it connects or asks about a host key, which it does in canonical
# mode with echo. Measured with OpenSSH 9.6 (#313). The pty is gone once ssh has exited.
proc ssh_terminal {} {
    global spawn_out
    if { [catch { exec stty -a < $spawn_out(slave,name) } modes] } { return "" }
    if { [regexp {(^|\s)-icanon(\s|$)} $modes] } { return "session" }
    if { [regexp {(^|\s)-echo(\s|$)} $modes] } { return "secret" }
    return ""
}


eval spawn $cmd [ lrange $argv 1 [expr {$argc - 1}] ]

# Show everything the program prints, as it arrives, as a tab running ssh or telnet
# directly would: the banner, telnet's own lines, the host key question with its
# fingerprint, and the prompts this script answers. The passwords it types are not among
# them, since ssh and login turn echo off first. log_user was 0 until the spawn only so
# that spawn does not echo its command line. It used to stay 0 through the block below,
# so only what a pattern printed ever showed: a connection that failed left an empty tab
# (#212), and a new host key was trusted out of sight (#214). Printing from each branch
# instead loses what follows the match.
log_user 1

# The host key question is the user's to answer, as it is for a host without a stored
# password. This script used to answer yes, trusting any key, and then sent the password
# to the server that presented it (#216). Nothing typed reaches ssh while the block below
# waits, only during interact, so the question hands the terminal over until Enter and
# then goes on to the password prompt; an answer ssh refuses is asked again, and comes
# back here. Enter is \r, or \n if it was typed before interact left cooked mode.
# -nobuffer passes it on with what came before it, so the action sends no Enter of its own,
# which ssh would read as an empty password; without -nobuffer, interact holds the Enter
# back, and dropped an answer typed ahead of it. interact also returns when ssh ends, at
# Ctrl+C for one, having closed the spawn id, so the block must not go on then: an
# exp_continue fails there with a Tcl traceback in the tab. Each of these was measured, and
# each is a test.
#
# ssh need not ask for the password at all. It tries public keys first, and logs in with
# one the server accepts, and it can ask something the script does not answer, such as a
# key's passphrase. The block used to wait for the password for ever then, and the tab
# took no input (#313). So once ssh's session has started, the terminal is the user's, and
# so it is when ssh has read with echo off at two looks running, a second apart, with no
# pattern matched between them: the password prompt matches long before the second. A
# question that echoes is not told from connecting, and still waits. Telnet hands over
# after its timeout, as it always has.
# No comments inside the block: there a # line is read as a pattern.
#
# FreeRDP's certificate question is handed over the same way. FreeRDP 3 asks for a
# domain before the password, and gets an empty one: a domain goes in the user field as
# DOMAIN\user, and then it does not ask. FreeRDP 2 asks for the password only. FreeRDP has
# an expect block of its own, so that its Domain: pattern never meets an ssh banner.
if { $connection == "rdp" } {
    expect {
          -re {Domain: *$} { send "\n"; exp_continue; }
          $reg { send "$pass\n"; interact; }
          -re {\(Y/T/N\) $} {
              set answered 0
              interact -nobuffer -re "\r|\n" { set answered 1; return; }
              if { $answered } { exp_continue; }
          }
       }
} else {
    set asking 0
    expect {
          -re "login:|sername:" { send "$user\n"; exp_continue; }
          $reg { send "$pass\n"; exec kill -WINCH [ pid ]; interact; }
          -re "Are you sure you want to continue connecting|Please type 'yes'" {
              set answered 0
              interact -nobuffer -re "\r|\n" { set answered 1; return; }
              if { $answered } { exp_continue; }
          }
          timeout {
              if { $connection == "telnet" } {
                  interact
              } else {
                  set now [ssh_terminal]
                  if { $now == "session" } {
                      exec kill -WINCH [ pid ]
                      interact
                  } elseif { $now == "secret" && $asking } {
                      interact
                  } else {
                      set asking [expr { $now == "secret" }]
                      exp_continue
                  }
              }
          }
       }
}

# Every way out comes here, so the tab gets the status its program exited with, which
# Close console decides on (#210): an early exit reports 0, a clean exit, as the host key
# failure once did. One killed by a signal exited with none, and exp_wait gives 0 for it,
# a clean exit: report it as a shell does, 128 and the signal's number.
set ret [exp_wait]
if { [lindex $ret 4] == "CHILDKILLED" } {
    if { [catch { exec kill -l [lindex $ret 5] } number] } { set number 0 }
    exit [expr { 128 + $number }]
}
exit [lindex $ret 3]
