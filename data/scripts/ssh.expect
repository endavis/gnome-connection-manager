#!/usr/bin/expect

log_user 0
stty -echo

fconfigure stdin -blocking 1
gets stdin pass
fconfigure stdin -blocking 0


#capturar redimension de tamaño de pantalla y pasarlo al proceso ssh hijo
trap {
 set rows [stty rows]
 set cols [stty columns]
 stty rows $rows columns $cols < $spawn_out(slave,name)
} WINCH


set connection [ lindex $argv 0 ]

set i 0
foreach {arg} $argv {
   set i [ expr $i+1 ];
   if {$arg=="-l"} {
      set user [ lindex $argv $i ]
   }
}

if { $connection == "telnet" } {
    set timeout 20
    set cmd "/usr/bin/telnet"
    set reg "assword:"
} else {
    set timeout -1
    set cmd "/usr/bin/ssh"
    set reg "assword:"
}


eval spawn $cmd [ lrange $argv 1 [expr {$argc - 1}] ]

# Show everything the program prints, as it arrives, as a tab running ssh or telnet
# directly would: the banner, telnet's own lines, the host key question this script
# answers with its fingerprint, and the prompts it answers. The passwords it types are
# not among them, since ssh and login turn echo off first. log_user was 0 until the
# spawn only so that spawn does not echo its command line. It used to stay 0 through the
# block below, so only what a pattern printed ever showed: a connection that failed left
# an empty tab (#212), and a new host key was trusted out of sight (#214). No comments
# inside the block: there a # line is read as a pattern.
log_user 1

expect {
          -re "login:|sername:" { send "$user\n"; exp_continue; }
          $reg { send "$pass\n"; exec kill -WINCH [ pid ]; interact; }
          -re "Are you sure you want to continue connecting (yes/no.*)?" { send "yes\n"; exp_continue; }
          timeout { interact; }
       }

# Every way out comes here, so the tab gets the status ssh or telnet exited with, which
# Close console decides on (#210).
set ret [exp_wait]
set status [lindex $ret 3]
exit $status
