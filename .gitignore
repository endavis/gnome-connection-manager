# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
.venv*/
venv/
ENV/
env/
.uv/
.uv-cache/

# IDEs
# .vscode/ is deliberately absent from this list: the template tracks it so contributors
# share the recommended extensions, debug configurations and task shortcuts (#128).
# Per-developer overrides go in .vscode/settings.local.json, which VS Code reads and git
# does not see.
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.hypothesis/
# mutmut's working copy, made by `doit mutate` at the repository root.
/mutants/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Ruff
.ruff_cache/

# Project specific
*.deb
*.rpm
/lang/*/LC_MESSAGES/*.mo
# The template's rule, not a bare `tmp/`: git lists a folder holding a tracked file file by
# file, so `doit pr_merge` tells a worktree's tmp/.uv_cache from someone's notes there. A
# bare `tmp/` showed it as one entry, which kept every worktree with anything in it (#332).
tmp/*
!tmp/.gitkeep

# User data (don't commit test configs)
.gcm/
gcm.conf
.gcm.key

# doit task state
.doit.db*

# Packaging
*.whl

# direnv
.direnv/
.envrc.local

# Environment variables
.env
.env.*

# Caches, and NFS's placeholders for files still open when deleted
.cache/
.nfs*

# Git worktrees made by `doit worktree`. Not temporary: each lives until its PR merges.
# Anchored to the root, so a directory named `worktrees` elsewhere stays tracked.
/worktrees/
# Claude Code's built-in worktree tool (EnterWorktree) creates worktrees here.
.claude/worktrees/

# The dangerous-command hook's debug log
tools/hooks/ai/hook-debug.jsonl

# mkdocs build output
site/

# Per-developer Claude Code settings; a pre-commit hook also refuses these
.claude/settings.local.json
# Where `gh` writes its state when HOME is unset.
.local/

# Per-user agent role overrides (CLI and model names are personal; see docs/development/ai/agent-roles.md)
/.config/pyproject_template/agents.local.toml
