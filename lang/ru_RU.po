msgstr "Командная строка"

msgid "{name}, {address}, {port}, {user}, {group}, {folder} and {type} are the host's, each quoted for the shell. {password} is its password, given to the command as GCM_PASSWORD in its environment, never on a command line. It runs through sh, from your home folder."
msgstr "{name}, {address}, {port}, {user}, {group}, {folder} и {type} — значения хоста, каждое экранировано для оболочки. {password} — его пароль, который передаётся команде в окружении как GCM_PASSWORD и никогда не попадает в командную строку. Команда выполняется через sh из вашей домашней папки."

msgid "A command host needs a command, on its Command line tab."
msgstr "Хосту-команде нужна команда на его вкладке «Командная строка»."

